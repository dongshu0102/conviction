# Copy this file to .env.local and adjust as needed.
# Next.js only reads .env.local at dev-server STARTUP — after creating
# or editing it, fully stop and restart `npm run dev` (Ctrl+C, then
# rerun). Saving the file alone does not pick up changes; this exact
# gap has been hit multiple times in local testing.

# Points the frontend at your local backend (uvicorn on :8000).
# Comment out (or delete this file) to fall back to the production
# default baked into lib/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
